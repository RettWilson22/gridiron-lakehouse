# Copy to .env (git-ignored) and fill in. Used by scripts/sync_to_snowflake.py (make sync),
# the local dbt `snowflake` target and scripts/export_public_snapshot.py --from-databricks.
# Never commit real values.

# Databricks: SQL warehouse connection details (SQL Warehouses > your warehouse > Connection details)
DATABRICKS_HOST=<workspace-host>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# Optional: without a token, auth comes from a Databricks CLI profile (databricks auth login).
# DATABRICKS_TOKEN=<personal-access-token>
# DATABRICKS_CONFIG_PROFILE=DEFAULT
GRIDIRON_SOURCE_CATALOG=workspace
GRIDIRON_SOURCE_SCHEMA=gridiron_serving

# Snowflake: key-pair authentication is recommended (see README)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=GRIDIRON_SYNC
SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8
# SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=GRIDIRON_LOADER
SNOWFLAKE_WAREHOUSE=GRIDIRON_WH
SNOWFLAKE_DATABASE=GRIDIRON
SNOWFLAKE_SCHEMA=SYNCED
